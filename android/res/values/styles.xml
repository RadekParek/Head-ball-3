<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="splash">#0c1830</color>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/splash</item>
        <item name="android:navigationBarColor">@color/splash</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#ffce4b</item>
    </style>
</resources>
